MDK-ARM/*/DebugConfig/
Objects/
Listings/
DebugConfig/
build/
Build/

# ================= 系统 / 编辑器 =================
Thumbs.db
Desktop.ini
.DS_Store
# VS Code：tasks / launch / c_cpp_properties / live_watch 已入库（路径全走环境变量）
# settings.json 是本机生成物，由 tools/setup-vscode.ps1 生成，不入库
.vscode/settings.json
.vscode/settings.json.bak
.vscode/browse.vc.db*
.vscode/ipch/
# Keil Assistant 扩展在工程子目录留下的旧日志/配置（2025 年的残留）
MDK-ARM/.vscode/
.idea/
.settings/
*.swp
*~

# ================= 日志 / 缓存 =================
*.log
__pycache__/
*.pyc
# ===== S27_TEST_2 专属 =====
_backup_*/
_archived_*/
tools/selftest/build/

# 链接脚本是手写的，不能丢（*.sct 规则会误伤）
!MDK-ARM/ATS_H7_Template/ATS_H7_Template.sct

# clangd / 编译数据库（本机生成，不入库）
.cache/
compile_commands.json
