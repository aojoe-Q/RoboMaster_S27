{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: Rebuild (自动选择系统)",
      "detail": "自动选择：Linux ARM GCC + Make；Windows Keil ARMCLANG；全量重编译并显示诊断",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/cmake/build.sh",
        "Debug",
        "--clean-first"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        {
          "base": "$gcc",
          "owner": "s27-gcc",
          "source": "ARM GCC",
          "fileLocation": "absolute",
          "applyTo": "allDocuments"
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true,
        "revealProblems": "onProblem"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/tools/build-windows-keil.ps1",
          "-Rebuild"
        ],
        "problemMatcher": [
          {
            "base": "$gcc",
            "owner": "s27-gcc",
            "source": "ARMCLANG",
            "fileLocation": [
              "autoDetect",
              "${workspaceFolder}/MDK-ARM"
            ],
            "applyTo": "allDocuments"
          },
          {
            "owner": "s27-keil",
            "source": "ARMCLANG",
            "fileLocation": [
              "autoDetect",
              "${workspaceFolder}/MDK-ARM"
            ],
            "applyTo": "allDocuments",
            "pattern": {
              "regexp": "^(.+?)\\((\\d+)\\):\\s*(?:fatal\\s+)?(warning|error):\\s*(.*)$",
              "file": 1,
              "line": 2,
              "severity": 3,
              "message": 4
            }
          }
        ]
      }
    },
    {
      "label": "Build: Debug (自动选择系统)",
      "detail": "自动选择：Linux ARM GCC + Make；Windows Keil ARMCLANG",
